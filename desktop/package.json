{
  "name": "zvs-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build:native": "npm --prefix ../crates/tools run build",
    "predev": "npm run build:native",
    "dev": "electron-vite dev",
    "build": "npm run build:native && tsc -b && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b --pretty false",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.20",
    "@fontsource-variable/onest": "^5.3.0",
    "@kiyotakkkka/zvs-uikit-lib": "^8.1.0",
    "@lancedb/lancedb": "^0.33.0",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.47",
    "better-sqlite3": "^13.0.2",
    "docx": "^9.7.1",
    "mammoth": "^1.12.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.3",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^39.8.10",
    "electron-vite": "^4.0.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "better-sqlite3@13.0.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "onnxruntime-node@1.19.2": true,
    "protobufjs@7.6.5": true,
    "sharp@0.33.5": true
  }
}
